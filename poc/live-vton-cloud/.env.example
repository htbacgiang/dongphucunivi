# Decart permanent API key — server-side only; never use NEXT_PUBLIC_*
DECART_API_KEY=

# Exact public origin used for the PoC (no trailing slash)
APP_ORIGIN=http://localhost:3020

# Both gates must be explicitly enabled before any real camera stream can reach Decart.
UNIVI_LIVE_VTON_ENABLED=false
UNIVI_DECART_LEGAL_APPROVED=false

# Internal access code, at least 24 random characters. Never commit the real value.
UNIVI_POC_ACCESS_CODE=
